{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WP1 Evaluator Score Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "rubric_version", "evaluated_at", "experiment_id",
    "run_id", "incident_id", "run_status", "scorable", "input_hashes", "overall_score",
    "applicable_weight", "metrics", "details", "manual_review"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "rubric_version": {"type": "string"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "experiment_id": {"type": "string"},
    "run_id": {"type": "string"},
    "incident_id": {"type": "string", "pattern": "^incident[0-9]{2}$"},
    "run_status": {"type": "string"},
    "scorable": {"const": true},
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_manifest", "assessment", "ground_truth", "scoring_rubric"],
      "properties": {
        "run_manifest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "assessment": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "ground_truth": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scoring_rubric": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "overall_score": {"type": "number", "minimum": 0, "maximum": 1},
    "applicable_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
    },
    "details": {"type": "object"},
    "manual_review": {"type": "object"}
  }
}
